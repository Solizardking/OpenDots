    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "better-auth": "1.7.7",
    "bn.js": "5.2.4",
    "browser-use-sdk": "^3.11.3",
    "bs58": "^6.0.0",
    "hono": "^4.13.11",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
