    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CopilotKit/OpenDots.git"
