{
  "name": "opendots",
  "version": "0.2.3",
  "description": "Solana Dots — a local-first Solana agent workspace with chat, Spaces, computers, side drawers, and phone pairing.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"cross-env NODE_ENV=development node --env-file-if-exists=.env --import tsx --watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-trading-runtime.mjs",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "browser": "node --env-file-if-exists=.env --import tsx src/browser/index.ts",
    "browser:start": "node --env-file-if-exists=.env dist/server/browser/index.js",
    "test": "cross-env DO_NOT_TRACK=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown",
    "check-format": "prettier --check src tests *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron electron/main.mjs",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "desktop:notarize": "node scripts/notarize-desktop.mjs",
    "verify:openmarket": "vitest run tests/openmarket.test.mjs tests/openmarket-access.test.ts && node --import tsx scripts/verify-openmarket-ui.mjs",
    "verify:openmarket-provider": "node --env-file-if-exists=.env --import tsx scripts/verify-openmarket-provider.mjs",
    "verify:birdeye-ui": "node --import tsx scripts/verify-birdeye-ui.mjs",
    "verify:birdeye-provider": "node --env-file-if-exists=.env --import tsx scripts/verify-birdeye-provider.mjs",
    "verify:birdeye-stream": "node --env-file-if-exists=.env --import tsx scripts/verify-birdeye-stream.mjs"
  },
  "keywords": [],
  "author": "Atai Barkai",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@better-auth/infra": "0.4.17",
    "@copilotkit/channels": "^0.11.0",
    "@copilotkit/core": "^1.75.0",
    "@copilotkit/react-core": "^1.75.0",
    "@copilotkit/runtime": "^1.75.0",
    "@e2b/desktop": "^2.4.0",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/curves": "2.2.0",
    "@open-wallet-standard/core": "^1.4.3",
    "@privy-io/react-auth": "^3.48.1",
    "@pump-fun/pump-sdk": "4.0.0",
    "@pump-fun/pump-swap-sdk": "2.1.0",
    "@solana-program/memo": "^0.12.0",
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.1.1",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-standard-util": "^1.2.0",
    "@solana/web3.js": "^1.99.0",
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "@spectrum-ts/telegram": "12.10.1",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-openai": "^0.25.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
