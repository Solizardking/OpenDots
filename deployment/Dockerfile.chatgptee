FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
RUN npm prune --omit=dev

FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4310 DATABASE_PATH=/data/opendots.sqlite USER_DATA_PATH=/data/users OWS_VAULT_PATH=/data/ows
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
RUN mkdir -p /data && chown node:node /data
COPY --from=build /app/dist ./dist
COPY deployment/start-chatgptee.sh /usr/local/bin/start-chatgptee
RUN chmod 755 /usr/local/bin/start-chatgptee
EXPOSE 4310
CMD ["/usr/local/bin/start-chatgptee"]
