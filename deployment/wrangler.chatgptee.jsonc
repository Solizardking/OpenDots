{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chatgptee-edge",
  "main": "chatgptee-edge.mjs",
  "account_id": "7640372571bf2d69ed5d58a6a6d8929e",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "BRAND_ASSETS",
    "run_worker_first": true,
  },
  "routes": [
    // The apex chatgptee.ai custom domain belongs to the chatgptee-desktop
    // worker; this worker only claims www to avoid the route clash.
    { "pattern": "www.chatgptee.ai", "custom_domain": true },
  ],
  "vars": {
    "APP_UPSTREAM": "https://chatgptee-production.up.railway.app",
    "PRIVY_AUTH_ORIGIN": "https://privy.chatgptee.ai",
  },
}
